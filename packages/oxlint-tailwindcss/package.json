{
  "name": "oxlint-tailwindcss",
  "version": "1.16.0",
  "description": "Tailwind CSS v4 lint rules for oxlint that read your design system: unknown, conflicting and deprecated classes, theme colors, class order — with autofixes.",
  "keywords": [
    "classnames",
    "css",
    "design-system",
    "lint",
    "linter",
    "oxc",
    "oxlint",
    "oxlint-plugin",
    "shadcn",
    "tailwind",
    "tailwind-css",
    "tailwindcss",
    "tailwindcss-v4"
  ],
  "homepage": "https://oxlint-tailwindcss.pages.dev",
  "bugs": {
    "url": "https://github.com/sergioazoc/oxlint-tailwindcss/issues"
  },
  "license": "MIT",
  "author": "Sergio Azocar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergioazoc/oxlint-tailwindcss.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./config": {
      "types": {
        "import": "./dist/config.d.mts",
        "require": "./dist/config.d.cts"
      },
      "import": "./dist/config.mjs",
      "require": "./dist/config.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run --exclude 'tests/benchmarks/**'",
    "test:watch": "vp test --exclude 'tests/benchmarks/**'",
    "bench": "vp test run --config vitest.bench.config.ts --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@tailwindcss/node": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.4",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
