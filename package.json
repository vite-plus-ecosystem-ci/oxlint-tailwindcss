{
  "name": "oxlint-tailwindcss-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for oxlint-tailwindcss plugin and its documentation site",
  "homepage": "https://github.com/sergioazoc/oxlint-tailwindcss#readme",
  "bugs": {
    "url": "https://github.com/sergioazoc/oxlint-tailwindcss/issues"
  },
  "license": "MIT",
  "author": "Sergio Azocar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergioazoc/oxlint-tailwindcss.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm -C packages/docs dev",
    "build": "pnpm -C packages/oxlint-tailwindcss build",
    "build:watch": "pnpm -C packages/oxlint-tailwindcss dev",
    "test": "pnpm -C packages/oxlint-tailwindcss test && pnpm -C packages/docs test",
    "test:watch": "pnpm -C packages/oxlint-tailwindcss test:watch",
    "bench": "pnpm -C packages/oxlint-tailwindcss bench",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint:types": "vp lint --type-aware packages/oxlint-tailwindcss/src",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "pnpm -C packages/oxlint-tailwindcss typecheck",
    "docs:build": "pnpm -C packages/docs build",
    "docs:preview": "pnpm -C packages/docs preview",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=12.6.0"
  },
  "packageManager": "pnpm@12.10.1"
}
